# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDEs and OS files
.idea/
.vscode/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehgcmds.sid
Thumbs.db
Desktop.ini

# Checkpoints and local outputs
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.onnx
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.joblib
*.pdf
*.svg
*.json
*.aimodel
*.aimodelc
*.png

# ...but the vendored report sources and their figures must be tracked, or the
# compile_* scripts cannot run from a fresh clone.
!reports/assets/*.png
!reports/assets/*.jpg
!src/bits_logo.png
!src/bits_logo.svg

/tmp/
/artifacts/
biomolecular_design/
/compiled_surrogate*/
/boltz_results*/
/scratch/
~$*

# Reproducibility provenance JSON that must stay versioned.
!data/benchmarks/frozen/**/*.json
!experiments/**/metrics.json
!results/real/**/*.json

# Model weights are fetched separately; keep only directory docs/placeholders.
weights/*
!weights/.gitkeep
!weights/README.md

# PoseBusters scratch: extracted peptide chains, regenerated on each run
/.pb_work/

# Results committed deliberately: the JSON under results/ is the measured
# output a reader needs to check a claim, not the multi-GB prediction cache
# that /artifacts/ holds. Small, and worth keeping under version control.
!results/**/*.json
